# Application
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=13000
APP_KEY=your-secret-key

# Database
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=nocobase
DB_USER=nocobase
DB_PASSWORD=nocobase
DB_LOGGING=off

# Cache
CACHE_DEFAULT_STORE=memory

# Storage
INIT_ROOT_EMAIL=admin@nocobase.com
INIT_ROOT_PASSWORD=admin123
INIT_ROOT_NICKNAME=Super Admin

# Locale
DEFAULT_LOCALE=zh-TW

# Plugin
PLUGIN_PACKAGE_PREFIX=@nocobase/plugin-,@nocobase/preset-,nocobase-plugin-

# Telemetry
TELEMETRY_ENABLED=false