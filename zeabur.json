{
  "name": "nocobase-zh-tw",
  "services": [
    {
      "name": "nocobase-zh-tw",
      "source": {
        "type": "git"
      },
      "template": {
        "type": "nodejs"
      },
      "env": {
        "APP_ENV": "production",
        "APP_HOST": "0.0.0.0",
        "APP_PORT": "13000",
        "DEFAULT_LOCALE": "zh-TW",
        "INIT_ROOT_EMAIL": "admin@nocobase.com",
        "INIT_ROOT_PASSWORD": "admin123",
        "INIT_ROOT_NICKNAME": "管理員",
        "TELEMETRY_ENABLED": "false",
        "PLUGIN_PACKAGE_PREFIX": "@nocobase/plugin-,@nocobase/preset-,nocobase-plugin-"
      },
      "buildCommand": "yarn install --frozen-lockfile && yarn nocobase install && yarn build",
      "startCommand": "yarn nocobase start",
      "ports": [
        {
          "port": 13000,
          "type": "HTTP"
        }
      ]
    },
    {
      "name": "postgres",
      "template": {
        "type": "postgresql"
      }
    }
  ]
}